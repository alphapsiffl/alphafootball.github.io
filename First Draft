.member-meta{margin-top:8px;color:#aaa;font-family:Oswald,Arial,sans-serif;font-size:14px;line-height:1.35;letter-spacing:.5px}
.member-meta span{color:var(--red);font-family:"Roboto Slab",serif;font-weight:900;font-size:18px}

.founder-badge{display:inline-block;margin-top:10px;padding:3px 7px;border:1px solid var(--red);color:var(--red);font-size:10px;letter-spacing:1px;font-weight:700;text-transform:uppercase;background:rgba(201,44,24,.08)}

.accolades{margin-top:13px;padding-top:10px;border-top:1px solid #333;text-align:left}
.accolades-title{color:var(--red);font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;margin-bottom:4px}
.accolades-placeholder{color:#777;font-family:Arial,sans-serif;font-size:11px;line-height:1.35;font-style:italic}

.accolade-badge{position:relative;display:inline-block;margin:2px 3px 3px 0;padding:4px 7px;border:1px solid #5b5b5b;background:#151515;color:#ddd;font-family:Oswald,Arial,sans-serif;font-size:11px;line-height:1.2;cursor:help}
.accolade-badge:hover,.accolade-badge:focus{border-color:var(--red);color:#fff;outline:none}
.accolade-tooltip{visibility:hidden;opacity:0;position:absolute;z-index:50;left:50%;bottom:calc(100% + 8px);transform:translateX(-50%) translateY(4px);width:190px;padding:9px 10px;background:#090909;border:1px solid var(--red);box-shadow:0 8px 22px rgba(0,0,0,.65);color:#eee;font-family:Arial,sans-serif;font-size:11px;line-height:1.35;text-align:center;pointer-events:none;transition:opacity .15s ease,transform .15s ease}
.accolade-tooltip:after{content:"";position:absolute;left:50%;bottom:-6px;width:10px;height:10px;background:#090909;border-right:1px solid var(--red);border-bottom:1px solid var(--red);transform:translateX(-50%) rotate(45deg)}
.accolade-badge:hover .accolade-tooltip,.accolade-badge:focus .accolade-tooltip{visibility:visible;opacity:1;transform:translateX(-50%) translateY(0)}
@media(max-width:650px){.accolade-tooltip{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);width:min(260px,80vw)}.accolade-badge:hover .accolade-tooltip,.accolade-badge:focus .accolade-tooltip{transform:translateX(-50%)}}

.member-record{color:var(--red);font-family:"Roboto Slab",serif;font-weight:900;font-size:18px}

.history-logo-card{max-width:760px;margin:30px auto;padding:28px;text-align:center;background:rgba(14,14,14,.92);border:1px solid #333;box-shadow:0 14px 35px rgba(0,0,0,.35)}
.history-label{display:inline-block;color:var(--red);border:1px solid var(--red);padding:5px 10px;font-size:11px;letter-spacing:2px;font-weight:700;margin-bottom:20px}
.history-logo{display:block;width:min(620px,100%);margin:0 auto 22px;border:1px solid #444}
.history-logo-card h3{font-family:"Roboto Slab",serif;font-size:25px;margin:8px 0}

